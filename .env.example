# Copia este archivo a .env.local si quieres probar el login de Google en tu
# máquina (npm run dev). Nunca subas .env ni .env.local a git — ya están en
# .gitignore. En Vercel estas mismas variables se agregan en el dashboard del
# proyecto (Settings → Environment Variables), no en un archivo.

# Postgres (Neon). Sin esto, npm run dev usa una base local (PGLite) que se
# pierde al reiniciar — está bien para probar, no sirve para producción.
# DATABASE_URL=postgres://usuario:password@host/basededatos

# URL pública de esta app. En Vercel: https://azagro.vercel.app (o tu dominio).
# Local: no hace falta, usa http://localhost:8080 automáticamente.
# BETTER_AUTH_URL=https://azagro.vercel.app

# Llave secreta de Better Auth. Genera una con: openssl rand -hex 32
# BETTER_AUTH_SECRET=

# Credenciales de "Iniciar sesión con Google" (Google Cloud Console →
# APIs & Services → Credentials → Create Credentials → OAuth client ID).
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
